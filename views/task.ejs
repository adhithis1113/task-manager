<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= task.title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header><h1>📝 Task Manager</h1></header>

  <main>
    <article class="full-task">
      <h2><%= task.title %></h2>
      <p class="full-text"><%= task.description || 'No description provided.' %></p>
      <a class="read-more" href="/">← Back to all tasks</a>
    </article>
  </main>
</body>
</html>